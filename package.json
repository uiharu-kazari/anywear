{
  "name": "anywear",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "build:anna": "tsc -b && vite build --mode anna",
    "anna:dev": "npm run build:anna && cd anna && anna-app dev",
    "anna:validate": "npm run build:anna && cd anna && anna-app validate --strict",
    "start": "NODE_ENV=production tsx server/index.ts",
    "preview": "vite preview",
    "test:e2e": "npm run test:e2e:build && playwright test -c e2e && npm run test:e2e:coverage",
    "test:e2e:build": "COVERAGE=1 vite build --mode anna --outDir e2e/.build/anna --emptyOutDir && COVERAGE=1 VITE_API_BASE=http://web.test/ vite build --outDir e2e/.build/web --emptyOutDir",
    "test:e2e:coverage": "nyc report --temp-dir e2e/.nyc_output --report-dir e2e/coverage --reporter=text --reporter=html --check-coverage --lines 100 --branches 100 --functions 100 --statements 100",
    "test:e2e:release": "npm run build:anna && E2E_ANNA_DIR=anna/bundle playwright test -c e2e anna-release"
  },
  "dependencies": {
    "@fontsource/cormorant": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@google/genai": "^1.16.0",
    "@hono/node-server": "^1.14.0",
    "dotenv": "^17.4.2",
    "hono": "^4.7.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.19.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "nyc": "^18.0.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-istanbul": "^7.2.1"
  }
}
